data-mat-icon-type="font" ngh="1">settings<span id="mat-badge-content-5" aria-hidden="true" class="mat-badge-content mat-badge-active">am</span></mat-icon><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></button><!----></div><mat-menu _ngcontent-ng-c1292950075 ngh="6"><!----></mat-menu><mat-menu _ngcontent-ng-c1292950075 xposition="before" yposition="below" ngh="6"><!----></mat-menu><mat-menu _ngcontent-ng-c1292950075 xposition="before" yposition="below" ngh="6"><!----></mat-menu><mat-menu _ngcontent-ng-c1292950075 xposition="before" yposition="below" ngh="6"><!----></mat-menu><mat-menu _ngcontent-ng-c1292950075 xposition="before" yposition="below" ngh="6"><!----></mat-menu><!----></mat-toolbar><div _ngcontent-ng-c1292950075 class="content-container"><div _ngcontent-ng-c1292950075 class="outlet"><div _ngcontent-ng-c1292950075 style="min-height: 100%;"><router-outlet _ngcontent-ng-c1292950075></router-outlet><app-builds-home _nghost-ng-c2250036126 ngh="16"><app-intro-container _ngcontent-ng-c2250036126 _nghost-ng-c1386606756 ngh="1"><div _ngcontent-ng-c1386606756 class="intro-container"><h1 _ngcontent-ng-c2250036126 class="page-title">Albion Online Builds</h1><h2 _ngcontent-ng-c2250036126 class="page-subtitle">Create, find and share meta builds</h2><app-section _ngcontent-ng-c2250036126 sectiontitle="WHAT IS THE BUILDS SYSTEM?" _nghost-ng-c2433186295 ngh="8"><div _ngcontent-ng-c2433186295 class="section"><app-text-divider _ngcontent-ng-c2433186295 _nghost-ng-c3004522550 ngh="7"><div _ngcontent-ng-c3004522550 class="text-divider" style="margin: 5px 0px; cursor: default;" jsaction="click:;"><span _ngcontent-ng-c3004522550 class="text"><!----><div _ngcontent-ng-c2433186295 class="title-content"><!----><span _ngcontent-ng-c2433186295>WHAT IS THE BUILDS SYSTEM?</span></div><!----></span><!----><mat-divider _ngcontent-ng-c3004522550 role="separator" class="mat-divider line mat-divider-horizontal" aria-orientation="horizontal" ngh="1"></mat-divider></div></app-text-divider><p _ngcontent-ng-c2250036126> The Albion Online Builds System lets you create, share, and discover optimized character builds for every playstyle. Whether you're looking for the perfect PvP setup, a specialized PvE build, or efficient gathering configurations, find everything you need here. </p><p _ngcontent-ng-c2250036126>Perfect for solo players exploring new builds or guild leaders sharing proven strategies. Create your builds once, use them everywhere, and help the community discover new ways to play Albion Online.</p><p _ngcontent-ng-c2250036126>Builds calculate Average Item Power (IP) using Normal quality and your selected specs character.</p><!----></div></app-section><app-section _ngcontent-ng-c2250036126 sectiontitle="QUICK ACCESS" _nghost-ng-c2433186295 ngh="9"><div _ngcontent-ng-c2433186295 class="section"><app-text-divider _ngcontent-ng-c2433186295 _nghost-ng-c3004522550 ngh="7"><div _ngcontent-ng-c3004522550 class="text-divider" style="margin: 5px 0px; cursor: default;" jsaction="click:;"><span _ngcontent-ng-c3004522550 class="text"><!----><div _ngcontent-ng-c2433186295 class="title-content"><!----><span _ngcontent-ng-c2433186295>QUICK ACCESS</span></div><!----></span><!----><mat-divider _ngcontent-ng-c3004522550 role="separator" class="mat-divider line mat-divider-horizontal" aria-orientation="horizontal" ngh="1"></mat-divider></div></app-text-divider><div _ngcontent-ng-c2250036126 class="quick-access-grid"><div _ngcontent-ng-c2250036126 class="access-card primary"><div _ngcontent-ng-c2250036126 class="card-icon">🛠️</div><h3 _ngcontent-ng-c2250036126>Create New Build</h3><p _ngcontent-ng-c2250036126>Design your perfect character setup with our intuitive build creator. Choose gear, spells, and passives to craft the ideal build for your playstyle.</p><a _ngcontent-ng-c2250036126 routerlink="/builds/create" matbutton="filled" appcalloutbutton aria-label="Create a new Albion Online build" class="mdc-button mat-mdc-button-base afm-callout-button mdc-button--unelevated mat-mdc-unelevated-button mat-unthemed" mat-ripple-loader-uninitialized mat-ripple-loader-class-name="mat-mdc-button-ripple" href="/builds/create" ngh="10" jsaction="click:;"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><span class="mdc-button__label"> Start Creating </span><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></a></div><div _ngcontent-ng-c2250036126 class="access-card tertiary"><div _ngcontent-ng-c2250036126 class="card-icon">🏆</div><h3 _ngcontent-ng-c2250036126>All Builds</h3><p _ngcontent-ng-c2250036126>Discover the most popular and effective builds in the community. Filter by role, zone, and playstyle to find exactly what you need.</p><a _ngcontent-ng-c2250036126 routerlink="/builds/top" matbutton="filled" appcalloutbutton tone="tertiary" aria-label="Browse top rated Albion Online builds" class="mdc-button mat-mdc-button-base afm-callout-button mdc-button--unelevated mat-mdc-unelevated-button mat-unthemed afm-callout-button--tertiary" mat-ripple-loader-uninitialized mat-ripple-loader-class-name="mat-mdc-button-ripple" href="/builds/top" ngh="10" jsaction="click:;"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><span class="mdc-button__label"> Explore Builds </span><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></a></div><div _ngcontent-ng-c2250036126 class="access-card secondary"><div _ngcontent-ng-c2250036126 class="card-icon">📋</div><h3 _ngcontent-ng-c2250036126>Your Builds</h3><p _ngcontent-ng-c2250036126>Manage and edit all your custom builds in one place. Update your strategies as the meta evolves and keep your builds optimized.</p><a _ngcontent-ng-c2250036126 routerlink="/builds/yourbuilds" matbutton="filled" appcalloutbutton tone="surface" aria-label="View and manage your Albion Online builds" class="mdc-button mat-mdc-button-base afm-callout-button mdc-button--unelevated mat-mdc-unelevated-button mat-unthemed afm-callout-button--surface" mat-ripple-loader-uninitialized mat-ripple-loader-class-name="mat-mdc-button-ripple" href="/builds/yourbuilds" ngh="10" jsaction="click:;"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><span class="mdc-button__label"> View Your Builds </span><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></a></div><div _ngcontent-ng-c2250036126 class="access-card primary"><div _ngcontent-ng-c2250036126 class="card-icon">🧩</div><h3 _ngcontent-ng-c2250036126>Create Build Bundle</h3><p _ngcontent-ng-c2250036126>Group multiple builds into a themed bundle and share complete compositions for guildmates, teams, or friends.</p><a _ngcontent-ng-c2250036126 routerlink="/builds/bundles/create" matbutton="filled" appcalloutbutton aria-label="Create a new Albion Online build bundle" class="mdc-button mat-mdc-button-base afm-callout-button mdc-button--unelevated mat-mdc-unelevated-button mat-unthemed" mat-ripple-loader-uninitialized mat-ripple-loader-class-name="mat-mdc-button-ripple" href="/builds/bundles/create" ngh="10" jsaction="click:;"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><span class="mdc-button__label"> Build a Bundle </span><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></a></div><div _ngcontent-ng-c2250036126 class="access-card tertiary"><div _ngcontent-ng-c2250036126 class="card-icon">🗂️</div><h3 _ngcontent-ng-c2250036126>All Build Bundles</h3><p _ngcontent-ng-c2250036126>Browse curated bundle collections to quickly find sets of builds designed for specific activities and group sizes.</p><a _ngcontent-ng-c2250036126 routerlink="/builds/bundles" matbutton="filled" appcalloutbutton tone="tertiary" aria-label="Browse Albion Online build bundles" class="mdc-button mat-mdc-button-base afm-callout-button mdc-button--unelevated mat-mdc-unelevated-button mat-unthemed afm-callout-button--tertiary" mat-ripple-loader-uninitialized mat-ripple-loader-class-name="mat-mdc-button-ripple" href="/builds/bundles" ngh="10" jsaction="click:;"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><span class="mdc-button__label"> Explore Bundles </span><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></a></div><div _ngcontent-ng-c2250036126 class="access-card secondary"><div _ngcontent-ng-c2250036126 class="card-icon">📦</div><h3 _ngcontent-ng-c2250036126>Your Build Bundles</h3><p _ngcontent-ng-c2250036126>Review and update the bundle collections you have created to keep your preferred lineups ready for the battlefield.</p><a _ngcontent-ng-c2250036126 routerlink="/builds/bundles/your" matbutton="filled" appcalloutbutton tone="surface" aria-label="View and manage your Albion Online build bundles" class="mdc-button mat-mdc-button-base afm-callout-button mdc-button--unelevated mat-mdc-unelevated-button mat-unthemed afm-callout-button--surface" mat-ripple-loader-uninitialized mat-ripple-loader-class-name="mat-mdc-button-ripple" href="/builds/bundles/your" ngh="10" jsaction="click:;"><span class="mat-mdc-button-persistent-ripple mdc-button__ripple"></span><span class="mdc-button__label"> Manage Bundles </span><!----><span class="mat-focus-indicator"></span><span class="mat-mdc-button-touch-target"></span></a></div></div><!----></div></app-section><app-section _ngcontent-ng-c2250036126 sectiontitle="FIND ALBION ONLINE BUILDS" _nghost-ng-c2433186295 ngh="11"><div _ngcontent-ng-c2433186295 class="section"><app-text-divider _ngcontent-ng-c2433186295 _nghost-ng-c3004522550 ngh="7"><div _ngcontent-ng-c3004522550 class="text-divider" style="margin: 5px 0px; cursor: default;" jsaction="click:;"><span _ngcontent-ng-c3004522550 class="text"><!----><div _ngcontent-ng-c2433186295 class="title-content"><!----><span _ngcontent-ng-c2433186295>FIND ALBION ONLINE BUILDS</span></div><!----></span><!----><mat-divider _ngcontent-ng-c3004522550 role="separator" class="mat-divider line mat-divider-horizontal" aria-orientation="horizontal" ngh="1"></mat-divider></div></app-text-divider><app-subsection _ngcontent-ng-c2250036126 subsectiontitle="Browse All Builds" _nghost-ng-c2173513929 ngh="12"><div _ngcontent-ng-c2173513929 class="subsection" style="padding-inline-start: 15px;"><!----><!----><!----><h4 _ngcontent-ng-c2173513929><div _ngcontent-ng-c2173513929 class="title-content"><!----><!----><span _ngcontent-ng-c2173513929>Browse All Builds</span></div><!----></h4><!----><!----><!----><div _ngcontent-ng-c2250036126 class="browse-links"><a _ngcontent-ng-c2250036126 routerlink="/builds/top" aria-label="Browse top rated Albion Online builds" class="browse-link rated" href="/builds/top" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">⭐</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>Top Rated</h4><p _ngcontent-ng-c2250036126>Community favorites and proven winners</p></div></a><a _ngcontent-ng-c2250036126 aria-label="Browse most viewed Albion Online builds" class="browse-link popular" href="/builds/top?sortBy=youtubeViews" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">👀</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>Most Viewed</h4><p _ngcontent-ng-c2250036126>Builds with most YouTube views</p></div></a><a _ngcontent-ng-c2250036126 aria-label="Browse newest Albion Online builds" class="browse-link newest" href="/builds/top?sortBy=updatedAt" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">🆕</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>Newest Builds</h4><p _ngcontent-ng-c2250036126>Fresh builds from the community</p></div></a></div><!----></div></app-subsection><app-subsection _ngcontent-ng-c2250036126 subsectiontitle="Browse by Location" _nghost-ng-c2173513929 ngh="12"><div _ngcontent-ng-c2173513929 class="subsection" style="padding-inline-start: 15px;"><!----><!----><!----><h4 _ngcontent-ng-c2173513929><div _ngcontent-ng-c2173513929 class="title-content"><!----><!----><span _ngcontent-ng-c2173513929>Browse by Location</span></div><!----></h4><!----><!----><!----><div _ngcontent-ng-c2250036126 class="browse-links"><a _ngcontent-ng-c2250036126 aria-label="Browse open world Albion Online builds" class="browse-link open-world" href="/builds/top?locationTags=open_world" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">🌍</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>Open World</h4><p _ngcontent-ng-c2250036126>General open world builds</p></div></a><a _ngcontent-ng-c2250036126 aria-label="Browse solo dungeon Albion Online builds" class="browse-link solo-dungeon" href="/builds/top?locationTags=solo-dungeon" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">🏰</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>Solo Dungeons</h4><p _ngcontent-ng-c2250036126>Builds for solo dungeon farming</p></div></a><a _ngcontent-ng-c2250036126 aria-label="Browse Hellgate Albion Online builds" class="browse-link hellgate" href="/builds/top?locationTags=hellgate" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">🔥</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>Hellgate Builds</h4><p _ngcontent-ng-c2250036126>Optimized for Hellgate encounters</p></div></a><a _ngcontent-ng-c2250036126 aria-label="Browse Corrupted Dungeon Albion Online builds" class="browse-link corrupted-dungeon" href="/builds/top?locationTags=corrupted-dungeon" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">�</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>Corrupted Dungeons</h4><p _ngcontent-ng-c2250036126>Builds for Corrupted Dungeon PvP</p></div></a></div><!----></div></app-subsection><app-subsection _ngcontent-ng-c2250036126 subsectiontitle="Browse by Group Size" _nghost-ng-c2173513929 ngh="12"><div _ngcontent-ng-c2173513929 class="subsection" style="padding-inline-start: 15px;"><!----><!----><!----><h4 _ngcontent-ng-c2173513929><div _ngcontent-ng-c2173513929 class="title-content"><!----><!----><span _ngcontent-ng-c2173513929>Browse by Group Size</span></div><!----></h4><!----><!----><!----><div _ngcontent-ng-c2250036126 class="browse-links"><a _ngcontent-ng-c2250036126 aria-label="Browse solo Albion Online builds" class="browse-link solo" href="/builds/top?sizeTags=solo" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">👤</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>Solo Builds</h4><p _ngcontent-ng-c2250036126>Perfect builds for solo players</p></div></a><a _ngcontent-ng-c2250036126 aria-label="Browse duo Albion Online builds" class="browse-link duo" href="/builds/top?sizeTags=duo" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">👥</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>Duo Builds</h4><p _ngcontent-ng-c2250036126>Builds for groups of 2 players</p></div></a><a _ngcontent-ng-c2250036126 aria-label="Browse small group Albion Online builds" class="browse-link small-group" href="/builds/top?sizeTags=small_group" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">👫</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>Small Group</h4><p _ngcontent-ng-c2250036126>Builds for groups of 4-7 players</p></div></a><a _ngcontent-ng-c2250036126 aria-label="Browse zerg Albion Online builds" class="browse-link zerg" href="/builds/top?sizeTags=zerg" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">⚔️�</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>Zerg Builds</h4><p _ngcontent-ng-c2250036126>Mass combat and territory builds</p></div></a></div><!----></div></app-subsection><app-subsection _ngcontent-ng-c2250036126 subsectiontitle="Browse by Role &amp; Activity" _nghost-ng-c2173513929 ngh="12"><div _ngcontent-ng-c2173513929 class="subsection" style="padding-inline-start: 15px;"><!----><!----><!----><h4 _ngcontent-ng-c2173513929><div _ngcontent-ng-c2173513929 class="title-content"><!----><!----><span _ngcontent-ng-c2173513929>Browse by Role &amp; Activity</span></div><!----></h4><!----><!----><!----><div _ngcontent-ng-c2250036126 class="browse-links"><a _ngcontent-ng-c2250036126 aria-label="Browse DPS Albion Online builds" class="browse-link dps" href="/builds/top?roleTags=dps" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">⚔️</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>DPS Builds</h4><p _ngcontent-ng-c2250036126>High damage dealing builds</p></div></a><a _ngcontent-ng-c2250036126 aria-label="Browse tank Albion Online builds" class="browse-link tank" href="/builds/top?roleTags=tank" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">�️</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>Tank Builds</h4><p _ngcontent-ng-c2250036126>Defensive and crowd control builds</p></div></a><a _ngcontent-ng-c2250036126 aria-label="Browse Fame and Silver farming Albion Online builds" class="browse-link farming" href="/builds/top?activityTags=fame_silver_farm" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">🌾</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>Fame &amp; Silver Farm</h4><p _ngcontent-ng-c2250036126>Efficient builds for farming</p></div></a><a _ngcontent-ng-c2250036126 aria-label="Browse ganking Albion Online builds" class="browse-link ganking" href="/builds/top?activityTags=ganking" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">�️</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>Ganking Builds</h4><p _ngcontent-ng-c2250036126>Builds optimized for ganking players</p></div></a></div><!----></div></app-subsection><app-subsection _ngcontent-ng-c2250036126 subsectiontitle="Browse by Budget" _nghost-ng-c2173513929 ngh="12"><div _ngcontent-ng-c2173513929 class="subsection" style="padding-inline-start: 15px;"><!----><!----><!----><h4 _ngcontent-ng-c2173513929><div _ngcontent-ng-c2173513929 class="title-content"><!----><!----><span _ngcontent-ng-c2173513929>Browse by Budget</span></div><!----></h4><!----><!----><!----><div _ngcontent-ng-c2250036126 class="browse-links"><a _ngcontent-ng-c2250036126 aria-label="Browse newbie budget Albion Online builds" class="browse-link newbie-budget" href="/builds/top?budgetTag=newbie" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">👶</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>Newbie Budget</h4><p _ngcontent-ng-c2250036126>Builds under 100k silver</p></div></a><a _ngcontent-ng-c2250036126 aria-label="Browse low budget Albion Online builds" class="browse-link low-budget" href="/builds/top?budgetTag=low_budget" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">💰</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>Low Budget</h4><p _ngcontent-ng-c2250036126>Builds under 300k silver</p></div></a><a _ngcontent-ng-c2250036126 aria-label="Browse medium budget Albion Online builds" class="browse-link medium-budget" href="/builds/top?budgetTag=medium_budget" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">💳</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>Medium Budget</h4><p _ngcontent-ng-c2250036126>Builds under 2M silver</p></div></a><a _ngcontent-ng-c2250036126 aria-label="Browse high budget Albion Online builds" class="browse-link high-budget" href="/builds/top?budgetTag=high_budget" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">💎</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>High Budget</h4><p _ngcontent-ng-c2250036126>Builds under 5M silver</p></div></a></div><!----></div></app-subsection><app-subsection _ngcontent-ng-c2250036126 subsectiontitle="Discover Build Bundles" _nghost-ng-c2173513929 ngh="13"><div _ngcontent-ng-c2173513929 class="subsection" style="padding-inline-start: 15px;"><!----><!----><!----><h4 _ngcontent-ng-c2173513929><div _ngcontent-ng-c2173513929 class="title-content"><!----><!----><span _ngcontent-ng-c2173513929>Discover Build Bundles</span></div><!----></h4><!----><!----><!----><div _ngcontent-ng-c2250036126 class="browse-links"><a _ngcontent-ng-c2250036126 aria-label="Browse top Albion Online build bundles" class="browse-link bundle-featured" href="/builds/bundles" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">🗂️</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>Top Bundles</h4><p _ngcontent-ng-c2250036126>Popular compositions curated by the community</p></div></a><a _ngcontent-ng-c2250036126 aria-label="Browse recently updated Albion Online build bundles" class="browse-link bundle-updated" href="/builds/bundles?sortBy=updatedAt" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">🕒</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>Recently Updated</h4><p _ngcontent-ng-c2250036126>Bundles refreshed with the latest strategies</p></div></a><a _ngcontent-ng-c2250036126 aria-label="Browse small group Albion Online build bundles" class="browse-link bundle-small-group" href="/builds/bundles?sizeTags=small_group" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">👥</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>Small Group Bundles</h4><p _ngcontent-ng-c2250036126>Coordinated kits for 4-7 player teams</p></div></a></div><div _ngcontent-ng-c2250036126 class="browse-links"><a _ngcontent-ng-c2250036126 aria-label="Browse open world Albion Online build bundles" class="browse-link bundle-open-world" href="/builds/bundles?locationTags=open_world" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">🌍</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>Open World Bundles</h4><p _ngcontent-ng-c2250036126>Ready-to-go lineups for roaming content</p></div></a><a _ngcontent-ng-c2250036126 aria-label="Browse Black Zone Albion Online build bundles" class="browse-link bundle-black-zone" href="/builds/bundles?zoneTags=black_zone" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">⚫</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>Black Zone Bundles</h4><p _ngcontent-ng-c2250036126>High-risk, high-reward battle squads</p></div></a><a _ngcontent-ng-c2250036126 aria-label="Browse ganking Albion Online build bundles" class="browse-link bundle-ganking" href="/builds/bundles?activityTags=ganking" jsaction="click:;"><div _ngcontent-ng-c2250036126 class="link-icon">🗡️</div><div _ngcontent-ng-c2250036126 class="link-content"><h4 _ngcontent-ng-c2250036126>Ganking Bundles</h4><p _ngcontent-ng-c2250036126>Ambush-ready teams for swift takedowns</p></div></a></div><!----></div></app-subsection><!----></div></app-section><app-section _ngcontent-ng-c2250036126 sectiontitle="KEY FEATURES" _nghost-ng-c2433186295 ngh="9"><div _ngcontent-ng-c2433186295 class="section"><app-text-divider _ngcontent-ng-c2433186295 _nghost-ng-c3004522550 ngh="7"><div _ngcontent-ng-c3004522550 class="text-divider" style="margin: 5px 0px; cursor: default;" jsaction="click:;"><span _ngcontent-ng-c3004522550 class="text"><!----><div _ngcontent-ng-c2433186295 class="title-content"><!----><span _ngcontent-ng-c2433186295>KEY FEATURES</span></div><!----></span><!----><mat-divider _ngcontent-ng-c3004522550 role="separator" class="mat-divider line mat-divider-horizontal" aria-orientation="horizontal" ngh="1"></mat-divider></div></app-text-divider><div _ngcontent-ng-c2250036126 style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px; margin-top: 16px;"><app-feature _ngcontent-ng-c2250036126 featuretitle="Complete Build Creator" _nghost-ng-c2988303249 ngh="14"><div _ngcontent-ng-c2988303249 class="feature"><h3 _ngcontent-ng-c2988303249>Complete Build Creator</h3><!----><p _ngcontent-ng-c2250036126>Design comprehensive builds with gear, spells, passives, and consumables. Our intuitive interface makes it easy to experiment with different combinations and find your perfect setup.</p></div></app-feature><app-feature _ngcontent-ng-c2250036126 featuretitle="Legendary Trait Recommendations" _nghost-ng-c2988303249 ngh="14"><div _ngcontent-ng-c2988303249 class="feature"><h3 _ngcontent-ng-c2988303249>Legendary Trait Recommendations</h3><!----><p _ngcontent-ng-c2250036126>Recommend up to three compatible Legendary traits for each awakened .4 weapon, including target values and one optional alternative per trait. Readers can open their preferred combination directly in the Awakened Calculator.</p></div></app-feature><app-feature _ngcontent-ng-c2250036126 featuretitle="Smart Tagging System" _nghost-ng-c2988303249 ngh="14"><div _ngcontent-ng-c2988303249 class="feature"><h3 _ngcontent-ng-c2988303249>Smart Tagging System</h3><!----><p _ngcontent-ng-c2250036126>Tag your builds by role (Tank, DPS, Support), zone type (PvP, PvE, Gathering), and location (Roads, Black Zone, etc.) to help others find exactly what they're looking for.</p></div></app-feature><app-feature _ngcontent-ng-c2250036126 featuretitle="Community Ratings" _nghost-ng-c2988303249 ngh="14"><div _ngcontent-ng-c2988303249 class="feature"><h3 _ngcontent-ng-c2988303249>Community Ratings</h3><!----><p _ngcontent-ng-c2250036126>Rate and review builds from other players. See what the community thinks works best and discover hidden gems through detailed feedback and voting.</p></div></app-feature><app-feature _ngcontent-ng-c2250036126 featuretitle="Average IP Calculation" _nghost-ng-c2988303249 ngh="14"><div _ngcontent-ng-c2988303249 class="feature"><h3 _ngcontent-ng-c2988303249>Average IP Calculation</h3><!----><p _ngcontent-ng-c2250036126>Build cards show Average Item Power (IP) using Normal quality and your selected specs character.</p></div></app-feature><app-feature _ngcontent-ng-c2250036126 featuretitle="Estimated Market Value (EMV)" _nghost-ng-c2988303249 ngh="14"><div _ngcontent-ng-c2988303249 class="feature"><h3 _ngcontent-ng-c2988303249>Estimated Market Value (EMV)</h3><!----><p _ngcontent-ng-c2250036126> Every build displays its Estimated Market Value in silver based on live market data. Hover the EMV badge for a per-slot breakdown showing individual item prices from your preferred server, so you always know what a build actually costs. </p></div></app-feature><app-feature _ngcontent-ng-c2250036126 featuretitle="Advanced Filtering" _nghost-ng-c2988303249 ngh="14"><div _ngcontent-ng-c2988303249 class="feature"><h3 _ngcontent-ng-c2988303249>Advanced Filtering</h3><!----><p _ngcontent-ng-c2250036126>Find builds that match your exact needs with powerful filters. Search by weapon type, armor class, IP range, and specific content focus to discover your ideal setup.</p></div></app-feature><app-feature _ngcontent-ng-c2250036126 featuretitle="Easy Sharing" _nghost-ng-c2988303249 ngh="14"><div _ngcontent-ng-c2988303249 class="feature"><h3 _ngcontent-ng-c2988303249>Easy Sharing</h3><!----><p _ngcontent-ng-c2250036126>Share your builds with guild members, friends, or the entire community. Each build gets its own URL for easy linking and social media sharing.</p></div></app-feature><app-feature _ngcontent-ng-c2250036126 featuretitle="Personal Collection" _nghost-ng-c2988303249 ngh="14"><div _ngcontent-ng-c2988303249 class="feature"><h3 _ngcontent-ng-c2988303249>Personal Collection</h3><!----><p _ngcontent-ng-c2250036126>Save and organize all your builds in one place. Keep track of your main builds, experimental setups, and builds you want to try from other players.</p></div></app-feature></div><!----></div></app-section><app-section _ngcontent-ng-c2250036126 sectiontitle="HOW TO USE THE BUILDS SYSTEM" _nghost-ng-c2433186295 ngh="15"><div _ngcontent-ng-c2433186295 class="section"><app-text-divider _ngcontent-ng-c2433186295 _nghost-ng-c3004522550 ngh="7"><div _ngcontent-ng-c3004522550 class="text-divider" style="margin: 5px 0px; cursor: default;" jsaction="click:;"><span _ngcontent-ng-c3004522550 class="text"><!----><div _ngcontent-ng-c2433186295 class="title-content"><!----><span _ngcontent-ng-c2433186295>HOW TO USE THE BUILDS SYSTEM</span></div><!----></span><!----><mat-divider _ngcontent-ng-c3004522550 role="separator" class="mat-divider line mat-divider-horizontal" aria-orientation="horizontal" ngh="1"></mat-divider></div></app-text-divider><app-section-subtitle _ngcontent-ng-c2250036126 _nghost-ng-c617713571 ngh="1"><h3 _ngcontent-ng-c617713571>Creating Your First Build</h3></app-section-subtitle><app-subsection _ngcontent-ng-c2250036126 subsectiontitle="Getting Started" _nghost-ng-c2173513929 ngh="13"><div _ngcontent-ng-c2173513929 class="subsection" style="padding-inline-start: 15px;"><!----><!----><!----><h4 _ngcontent-ng-c2173513929><div _ngcontent-ng-c2173513929 class="title-content"><!----><!----><span _ngcontent-ng-c2173513929>Getting Started</span></div><!----></h4><!----><!----><!----><p _ngcontent-ng-c2250036126>Navigate to the <strong _ngcontent-ng-c2250036126>Create New Build</strong> section to begin designing your character setup:</p><ul _ngcontent-ng-c2250036126><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Choose Your Weapon:</strong> Select your main weapon and unlock relevant spells and passives</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Select Armor:</strong> Pick helmet, chest, and boots that complement your playstyle</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Add Accessories:</strong> Include cape, bag, and food to complete your loadout</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Configure Spells:</strong> Set up your skill rotations and passive abilities</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Name and Tag:</strong> Give your build a descriptive name and add relevant tags</li></ul><!----></div></app-subsection><app-subsection _ngcontent-ng-c2250036126 subsectiontitle="Recommending Legendary Traits" _nghost-ng-c2173513929 ngh="13"><div _ngcontent-ng-c2173513929 class="subsection" style="padding-inline-start: 15px;"><!----><!----><!----><h4 _ngcontent-ng-c2173513929><div _ngcontent-ng-c2173513929 class="title-content"><!----><!----><span _ngcontent-ng-c2173513929>Recommending Legendary Traits</span></div><!----></h4><!----><!----><!----><p _ngcontent-ng-c2250036126>When you select an awakenable .4 main-hand weapon, its Legendary recommendation editor appears below the item:</p><ul _ngcontent-ng-c2250036126><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Add Trait Slots:</strong> Add up to three ordered recommendations and choose from traits compatible with that weapon</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Offer Alternatives:</strong> Add one optional alternative to each slot, with an independent target value</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Set Target Values:</strong> Use the slider or exact-value editor; previews use Excellent quality and +0 mastery Item Power, and an Item Power trait updates the other displayed values</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Manage Each Weapon:</strong> Primary and alternative weapons keep separate recommendations, while changing or removing a weapon clears its previous recommendations</li></ul><!----></div></app-subsection><app-subsection _ngcontent-ng-c2250036126 subsectiontitle="Optimizing Your Build" _nghost-ng-c2173513929 ngh="13"><div _ngcontent-ng-c2173513929 class="subsection" style="padding-inline-start: 15px;"><!----><!----><!----><h4 _ngcontent-ng-c2173513929><div _ngcontent-ng-c2173513929 class="title-content"><!----><!----><span _ngcontent-ng-c2173513929>Optimizing Your Build</span></div><!----></h4><!----><!----><!----><p _ngcontent-ng-c2250036126>Use these strategies to create effective builds:</p><ul _ngcontent-ng-c2250036126><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Synergy Focus:</strong> Choose gear and spells that work well together</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Purpose-Built:</strong> Design for specific content like Corrupted Dungeons, ZvZ, or Solo PvE</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>IP Considerations:</strong> Balance item power with cost-effectiveness</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Escape Options:</strong> Always include mobility or defensive options</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Resource Management:</strong> Consider mana costs and cooldown management</li></ul><!----></div></app-subsection><app-section-subtitle _ngcontent-ng-c2250036126 _nghost-ng-c617713571 ngh="1"><h3 _ngcontent-ng-c617713571>Discovering Great Builds</h3></app-section-subtitle><app-subsection _ngcontent-ng-c2250036126 subsectiontitle="Using Legendary Recommendations" _nghost-ng-c2173513929 ngh="13"><div _ngcontent-ng-c2173513929 class="subsection" style="padding-inline-start: 15px;"><!----><!----><!----><h4 _ngcontent-ng-c2173513929><div _ngcontent-ng-c2173513929 class="title-content"><!----><!----><span _ngcontent-ng-c2173513929>Using Legendary Recommendations</span></div><!----></h4><!----><!----><!----><p _ngcontent-ng-c2250036126>Build cards and details show Legendary recommendations beside supported weapons:</p><ul _ngcontent-ng-c2250036126><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Review the Targets:</strong> Compare each primary trait with its optional alternative and recommended in-game value</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Choose Your Combination:</strong> Select the preferred option for every slot when alternatives are available</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Open the Calculator:</strong> Open the exact weapon, selected traits, and target values in a new Awakened Calculator tab</li></ul><!----></div></app-subsection><app-subsection _ngcontent-ng-c2250036126 subsectiontitle="Using Filters Effectively" _nghost-ng-c2173513929 ngh="13"><div _ngcontent-ng-c2173513929 class="subsection" style="padding-inline-start: 15px;"><!----><!----><!----><h4 _ngcontent-ng-c2173513929><div _ngcontent-ng-c2173513929 class="title-content"><!----><!----><span _ngcontent-ng-c2173513929>Using Filters Effectively</span></div><!----></h4><!----><!----><!----><p _ngcontent-ng-c2250036126>Find builds that match your needs with smart filtering:</p><ul _ngcontent-ng-c2250036126><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Content Type:</strong> Filter by PvP, PvE, gathering, or specific dungeons</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Role-Based:</strong> Search for tank, DPS, support, or hybrid builds</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Zone Focus:</strong> Find builds optimized for Royal, Black Zone, or Roads</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Weapon Class:</strong> Browse by your preferred weapon categories</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Player Rating:</strong> See what the community recommends most</li></ul><!----></div></app-subsection><app-subsection _ngcontent-ng-c2250036126 subsectiontitle="Understanding Build Quality" _nghost-ng-c2173513929 ngh="13"><div _ngcontent-ng-c2173513929 class="subsection" style="padding-inline-start: 15px;"><!----><!----><!----><h4 _ngcontent-ng-c2173513929><div _ngcontent-ng-c2173513929 class="title-content"><!----><!----><span _ngcontent-ng-c2173513929>Understanding Build Quality</span></div><!----></h4><!----><!----><!----><p _ngcontent-ng-c2250036126>Evaluate builds using these indicators:</p><ul _ngcontent-ng-c2250036126><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Community Votes:</strong> Higher-rated builds tend to be more effective</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>View Count:</strong> Popular builds often have proven track records</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Detailed Descriptions:</strong> Look for builds with clear explanations</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Recent Updates:</strong> Newer builds reflect current meta changes</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Author Reputation:</strong> Experienced players often create better builds</li></ul><!----></div></app-subsection><app-section-subtitle _ngcontent-ng-c2250036126 _nghost-ng-c617713571 ngh="1"><h3 _ngcontent-ng-c617713571>Managing Your Collection</h3></app-section-subtitle><app-subsection _ngcontent-ng-c2250036126 subsectiontitle="Organizing Your Builds" _nghost-ng-c2173513929 ngh="13"><div _ngcontent-ng-c2173513929 class="subsection" style="padding-inline-start: 15px;"><!----><!----><!----><h4 _ngcontent-ng-c2173513929><div _ngcontent-ng-c2173513929 class="title-content"><!----><!----><span _ngcontent-ng-c2173513929>Organizing Your Builds</span></div><!----></h4><!----><!----><!----><p _ngcontent-ng-c2250036126>Keep your builds organized and up-to-date:</p><ul _ngcontent-ng-c2250036126><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Descriptive Names:</strong> Use clear, searchable names for easy identification</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Regular Updates:</strong> Refresh builds when items or meta change</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Version Control:</strong> Keep multiple versions for different situations</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Documentation:</strong> Add notes about when and how to use each build</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Sharing Strategy:</strong> Decide which builds to keep private vs. public</li></ul><!----></div></app-subsection><app-section-subtitle _ngcontent-ng-c2250036126 _nghost-ng-c617713571 ngh="1"><h3 _ngcontent-ng-c617713571>Tips for Success</h3></app-section-subtitle><app-subsection _ngcontent-ng-c2250036126 subsectiontitle="Building Like a Pro" _nghost-ng-c2173513929 ngh="12"><div _ngcontent-ng-c2173513929 class="subsection" style="padding-inline-start: 15px;"><!----><!----><!----><h4 _ngcontent-ng-c2173513929><div _ngcontent-ng-c2173513929 class="title-content"><!----><!----><span _ngcontent-ng-c2173513929>Building Like a Pro</span></div><!----></h4><!----><!----><!----><ul _ngcontent-ng-c2250036126><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Test Everything:</strong> Try builds in practice before committing to expensive gear</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Adapt to Meta:</strong> Stay updated with game changes and adjust accordingly</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Learn from Others:</strong> Study successful builds and understand their design principles</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Experiment Safely:</strong> Use lower-tier gear when testing new concepts</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Share Knowledge:</strong> Contribute to the community by publishing your successful builds</li><li _ngcontent-ng-c2250036126><strong _ngcontent-ng-c2250036126>Stay Flexible:</strong> Keep multiple builds ready for different situations</li></ul><!----></div></app-subsection><!----></div></app-section></div></app-intro-container></app-builds-home><!----></div><mat-divider _ngcontent-ng-c1292950075 role="separator" class="mat-divider mat-divider-horizontal" style="margin-top: 20px; margin-bottom: 10px;" aria-orientation="horizontal" ngh="1"></mat-divider><div _ngcontent-ng-c1292950075 style="width: 100%; display: flex; flex-direction: column; align-items: center;"><nav _ngcontent-ng-c1292950075 aria-label="Footer navigation" class="footer"><div _ngcontent-ng-c1292950075 class="footer-column"><p _ngcontent-ng-c1292950075><b _ngcontent-ng-c1292950075>MARKET</b></p><p _ngcontent-ng-c1292950075><a _ngcontent-ng-c1292950075 href="/pricecheck" jsaction="click:;">Market Prices</a></p><p _ngcontent-ng-c1292950075><a _ngcontent-ng-c1292950075 href="/topitems" jsaction="click:;">Top Traded Items</a></p><p _ngcontent-ng-c1292950075><a _ngcontent-ng-c1292950075 href="/upgrade-calculator" jsaction="click:;">Upgrade Calculator</a></p><p _ngcontent-ng-c1292950075><a _ngcontent-ng-c1292950075 href="/awakened-items" jsaction="click:;">Awakened Items</a></p><p _ngcontent-ng-c1292950075><a _ngcontent-ng-c1292950075 href="/awakened-calculator" jsaction="click:;">Awakened Calculator</a></p><!----></div><div _ngcontent-ng-c1292950075 class="footer-column"><p _ngcontent-ng-c1292950075><b _ngcontent-ng-c1292950075>TRADING</b></p><p _ngcontent-ng-c1292950075><a _ngcontent-ng-c1292950075 href="/flipper" jsaction="click:;">Market Flipper</a></p><p _ngcontent-ng-c1292950075><a _ngcontent-ng-c1292950075 href="/emv-flipper" jsaction="click:;">EMV Flipper</a></p><p _ngcontent-ng-c1292950075><a _ngcontent-ng-c1292950075 href="/traderoutes" jsaction="click:;">Trade Routes</a></p><p _ngcontent-ng-c1292950075><a _ngcontent-ng-c1292950075 href="/transport" jsaction="click:;">Trade Calculator</a></p><p _ngcontent-ng-c1292950075><a _ngcontent-ng-c1292950075 href="/portfolio" jsaction